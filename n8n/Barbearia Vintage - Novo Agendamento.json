        "jsCode": "// os dados enviados pelo Flask chegam dentro de \"body\"\nconst dados = $input.first().json.body;\n\n// converte a data de 2026-08-25 para 25/08/2026 (formato brasileiro)\nconst [ano, mes, dia] = dados.data.split(\"-\");\nconst dataFormatada = `${dia}/${mes}/${ano}`;\n\n// monta o assunto do email\nconst assunto = \"Agendamento confirmado - Barbearia Vintage\";\n\n// monta o corpo do email com as informacoes do agendamento\nconst mensagem = `Ola ${dados.cliente_nome},\n\nSeu agendamento foi registrado com sucesso.\n\nServico: ${dados.servico}\nData: ${dataFormatada}\nHorario: ${dados.horario}\nStatus: ${dados.status}\n\nAte breve!\nBarbearia Vintage`;\n\n// devolve os campos prontos para o proximo no (o de email) usar\nreturn [{\n  json: {\n    email: dados.cliente_email,\n    nome: dados.cliente_nome,\n    assunto: assunto,\n    mensagem: mensagem\n  }\n}];"
      },
